# Paquet Arch Linux de TimeLog.
# Ce fichier est copié et adapté (pkgver) par packaging/build-linux.sh, qui fournit
# l'archive source (arborescence usr/ déjà installée à l'échelle du système).
pkgname=timelog
pkgver=1.1.0
pkgrel=1
pkgdesc="Heures, journal de travail et notes (hors ligne, synchronisation optionnelle)"
arch=('x86_64')
url="https://github.com/Hoferlukaslh/TimeLog"
license=('GPL-3.0-only')
depends=('gtk3' 'gstreamer' 'gst-plugins-base-libs')
optdepends=(
  'gst-plugins-good: lecture audio (formats courants)'
  'pulseaudio: enregistrement audio (fournit parecord)'
  'ffmpeg: enregistrement audio (solution de repli)'
)
# Le bundle Flutter est déjà compilé et optimisé : pas de strip ni de paquet debug.
options=('!strip' '!debug')
source=("timelog-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
  install -Dm644 "$srcdir/usr/share/licenses/timelog/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
