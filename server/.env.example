# Copy to .env and change the passwords.
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# Web version of the application, served on the same port as the API: true or false.
# After changing it to true: docker compose up -d --build (the first build takes several minutes).
WEB_ENABLED=true
# Port of the server on this machine (API and web application).
TIMELOG_PORT=8787
# Days a login stays valid without use.
SESSION_DAYS=180
# Maximum size of one request (attachments), in MB.
MAX_BODY_MB=256
# Only with a reverse proxy in front (Caddy...): its address, CIDR, several separated by spaces.
# Example with Caddy on the Docker host: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
